---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import FrontDate from '../../components/FrontDate.astro'

export const getStaticPaths = async () => {
  const posts = await getCollection('posts')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, date, updated, keywords } = post.data

const description = `Mis notas sobre ${title}.`
const image = new URL('/images/draw.webp', Astro.site)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  keywords: keywords.join(', '),
  author: {
    '@type': 'Person',
    name: 'Jesus Gonzalo Machaca Hancco',
    url: canonicalURL.origin,
  },
  mainEntityOfPage: canonicalURL.href,
}
---

<Layout
  title={`${title} · loadept`}
  description={description}
  keywords={keywords.join(', ')}
  type="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="container mx-auto px-4 max-w-3xl py-12">
    <article class="
      prose
      dark:prose-invert
      prose-headings:text-primary
      prose-a:text-accent
      prose-p:text-base
      prose-p:text-foreground
      leading-relaxed
      max-w-none
    ">
      <h1 class="text-4xl font-bold text-primary mb-4">
        {title.toUpperCase()}
      </h1>
      <div class='text-sm text-muted-foreground mb-8'>
        <FrontDate date={date} updated={updated} />
      </div>
      <Content />
    </article>
  </div>
</Layout>
